# Local demo starts without credentials. Workshop VM variables already exist;
# do not overwrite them or fill in the organizer's config.example.
PHAROS_DEMO=true
PHAROS_BASE_PATH=
# Required by the generated workshop deployment. Local loopback demo defaults off.
PHAROS_REQUIRE_AUTH=false
PHAROS_OPERATOR_USERNAME=operator
PHAROS_OPERATOR_PASSWORD=
PHAROS_DATABASE=data/pharos.sqlite3
PHAROS_OUTPUT_DIR=data/runs
PHAROS_HISTORY_RETENTION_DAYS=30
PHAROS_PUBLIC_SOURCES=true
SOURCE_CACHE_TTL_SECONDS=300
SOURCE_CACHE_DIR=data/sources
# Enable only after the appropriate NYC DOT developer access agreement.
NYC_CAMERA_SNAPSHOTS_ENABLED=false
# Disabled until one designated owner reviews/authorizes an exact one-chunk preview.
PHAROS_REINGEST_ENABLED=false

# Assigned team environment, read server-side only.
USERNAME=
PASSWORD=
INGRESS_URL=
PIPELINE=
S3_ENDPOINT=
ACCESS_KEY=
SECRET_KEY=
S3_CHUNKS_BUCKET=
S3_SEGMENTS_BUCKET=
VDB_ENDPOINT=
VASTDB_BUCKET=
VDB_SCHEMA=vss-schema
VDB_COLLECTION=vss-collection
VDB_PROMPTS_COLLECTION=vss-prompts-events

WANDB_API_KEY=
WANDB_TEAM=
WANDB_PROJECT=
WANDB_BASE_URL=https://api.inference.wandb.ai/v1
# Choose an available provider model from /models; no fabricated default.
WANDB_MODEL=
WANDB_WEAVE_ENABLED=false

# Optional direct diagnostics; normal archive access goes through VSS.
# Preserve actual URLs and authentication from the assigned team configuration.
COSMOS3_REASON_URL=
COSMOS3_REASON_MODEL=nvidia/cosmos3-reason
COSMOS_EMBED1_URL=
COSMOS_EMBED1_MODEL=nvidia/cosmos-embed1
YOLO_URL=
GPU_BEARER_TOKEN=
SUMO_BINARY=sumo
